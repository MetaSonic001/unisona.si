# ─── Unisona local environment ─────────────────────────────────────────────
# This file is gitignored. Every key is optional unless marked REQUIRED.
# Missing optional keys never crash anything: the related feature is disabled
# and a warning is printed in the API console at startup.

UNISONA_ENV=development
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
API_PORT=8000

# Dev mode (local only). Unlocks /dev in the web app and a "Continue in dev mode"
# login that skips Clerk. Never enable in production.
DEV_MODE=true
DEV_AUTH_BYPASS=true
NEXT_PUBLIC_DEV_MODE=true
DEV_TOKEN=

# ─── REQUIRED: database (Supabase Postgres, session pooler, IPv4) ───────────
DATABASE_URL=
DB_SCHEMA=app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Local dev only: a Supabase personal access token (supabase.com/dashboard/account/tokens). If the free project was
# paused after 7 idle days, the API restores it automatically at startup and finishes starting once it's up (2–5 min).
# It has account-wide access: never set it on Render/Vercel.
SUPABASE_ACCESS_TOKEN=

# ─── REQUIRED: encryption master key for the BYOK vault (generated) ─────────
UNISONA_MASTER_KEY=

# ─── Clerk (auth, organizations = workspaces) ───────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Platform default AI keys (used when a workspace has not added its own) ─
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=

# ─── Vector store / local models ────────────────────────────────────────────
CHROMA_MODE=embedded
CHROMA_PATH=./data/chroma
DATA_DIR=./data
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_STT_ENABLED=true
LOCAL_STT_MODEL=small
# The multilingual reranker adds ~250 MB RAM; set false on small servers.
RERANKER_ENABLED=true

# ─── Hosting (production) ───────────────────────────────────────────────────
# LOG_FORMAT=plain prints one searchable line per log record (default when UNISONA_ENV=production).
LOG_FORMAT=
LOG_LEVEL=INFO
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=6
# Uploads and call recordings are mirrored to a private Supabase Storage bucket when NEXT_PUBLIC_SUPABASE_URL
# and SUPABASE_SECRET_KEY are set, so they survive redeploys on hosts with an ephemeral disk (Render).
STORAGE_BUCKET=unisona-files
# Browser voice calls through a hosted API (Render has no inbound UDP) need a TURN relay.
# Cloudflare Realtime TURN (free tier): create a TURN key in the Cloudflare dashboard → Realtime → TURN.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# …or any TURN provider with static credentials (comma-separated URLs):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ─── Channels (optional) ────────────────────────────────────────────────────
# WhatsApp Cloud API: your Meta app. Tenants connect their own numbers.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Telegram bots are added per workspace in the UI (bot token = BYOK); polling works locally.
# Telephony (per workspace in the UI). PUBLIC_WEBHOOK_URL is needed for phone calls (e.g. an ngrok URL).
PUBLIC_WEBHOOK_URL=

# Google Calendar two-way sync (OAuth client, type "Web application",
# redirect URI: <API_URL>/integrations/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Payments (optional): Dodo Payments ─────────────────────────────────────
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode

# ─── Notifications (optional) ───────────────────────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=
SLACK_ALERT_WEBHOOK_URL=
